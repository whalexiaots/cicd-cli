{
  "jenkins": {
    "host": "jenkins.example.com",
    "port": 443,
    "protocol": "https",
    "auth": {
      "method": "api_token",
      "username": "your_username",
      "api_token": "your_api_token"
    }
  },
  "gerrit": {
    "host": "gerrit.example.com",
    "port": 443,
    "protocol": "https",
    "auth": {
      "method": "http_password",
      "username": "your_username",
      "http_password": "your_http_password"
    }
  },
  "jira": {
    "host": "jira.example.com",
    "port": 443,
    "protocol": "https",
    "auth": {
      "method": "api_token",
      "username": "your_username",
      "api_token": "your_api_token"
    }
  },
  "ssh": {
    "host": "build-server.example.com",
    "port": 22,
    "user": "your_username",
    "password": "your_password",
    "remote_dir": "/home/user/workspace"
  },
  "ftp": {
    "host": "ftp.example.com",
    "port": 21,
    "user": "anonymous",
    "password": "",
    "local_dir": "/tmp/downloads",
    "max_retries": 3
  },
  "ftp_servers": {
    "chengdu": {
      "host": "ftp-cd.example.com",
      "port": 21,
      "user": "user",
      "password": "pass"
    }
  },
  "elink": {
    "host": "elink.example.com",
    "protocol": "https",
    "auth": {
      "method": "sso",
      "username": "your_username",
      "password": "(可选，SSO 模式不需要)",
      "aes_key": "(可选，SSO 模式不需要)"
    },
    "secrets_path": "~/.cicd-cli/secrets/elink.json",
    "module": 2,
    "_doc": "SSO 浏览器授权登录（推荐），回退到账号密码方式"
  },
  "projects": {
    "ProjectA": {
      "ssh": {
        "host": "<BUILD_SERVER_1>",
        "remote_dir": "/path/to/code"
      },
      "jenkins": {
        "job_name": "VerifyBuild_for_ProjectA"
      },
      "gerrit": {
        "project_prefix": "<GERRIT_PROJECT_PREFIX>"
      },
      "elink": {
        "project_id": "12345",
        "project_name": "ProjectA"
      }
    },
    "ProjectB": {
      "ssh": {
        "host": "build-vex.example.com",
        "remote_dir": "/home/user/vex"
      },
      "jenkins": {
        "job_name": "VerifyBuild_for_ProjectB"
      },
      "elink": {
        "project_id": "<PROJECT_ID>",
        "project_name": "<PROJECT_NAME>"
      }
    }
  }
}
